{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StageConfig": {
    "StageName": "DEV",
    "EnableDetailedErrors": false
  },
  "RateLimiting": {
    "ApiRequestsPerMinute": 120,
    "WriteRequestsPerMinute": 20,
    "ReviewRequestsPerMinute": 5,
    "ExemptPaths": [
      "/swagger",
      "/css",
      "/js",
      "/fonts",
      "/images",
      "/favicon.ico",
      "/robots.txt",
      "/v1/system/health"
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DemoMode": {
    "ResetOnStart": true
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "Https": {
    "Redirect": false
  }
}
